; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="WNI: Hari-Hari Biasa"
config/description="Game cozy pixel-art tentang hidup biasa seorang mahasiswa di Bandung Timur."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
TimeManager="*res://autoload/time_manager.gd"
Economy="*res://autoload/economy.gd"
NewsSystem="*res://autoload/news_system.gd"
SaveSystem="*res://autoload/save_system.gd"
Sfx="*res://autoload/audio_manager.gd"
Daily="*res://autoload/daily.gd"
Ach="*res://autoload/achievements.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.07, 0.1, 1)
